rules_version = '2';

// Rakta Bandhan — Firestore security rules.
//
// The app writes directly to Firestore; every invariant (single-active-
// match locking, contact reveal, admin-only verification/ban, two-sided
// donation completion, the 90-day cooldown) is enforced here, against the
// client-side transactions in lib/services/backend.dart. Cloud Functions
// (functions/) only send push notifications and expire old requests —
// they use the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A doc's mere existence at admins/{uid} is the admin flag — no
    // custom claims (those need the Admin SDK / a Cloud Function, which
    // Spark can't deploy).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Accounts must confirm their email (Firebase verification link) — or,
    // later, a phone number — before they can create anything. Stops
    // throwaway sign-ups from posting requests or messaging donors.
    function isVerifiedUser() {
      return isSignedIn()
        && (request.auth.token.get('email_verified', false) == true
            || request.auth.token.get('phone_number', null) != null);
    }

    // The post-donation rest period can't be shortened, removed, or ignored
    // by the donor: while it runs, the new value may only move later, and
    // the donor can't mark themselves available.
    function cooldownRespected() {
      let before = resource.data.get('reactivation_scheduled_at', null);
      let after = request.resource.data.get('reactivation_scheduled_at', null);
      return (before == null || before <= request.time || (after != null && after >= before))
        && (request.resource.data.get('is_available', false) != true
            || after == null || after <= request.time);
    }

    // True account disable needs the Admin SDK (Blaze-only) — this is the
    // Spark stand-in: a banned donor's own donors/{uid} doc is flagged,
    // and every write that matters (their own profile, new requests,
    // accepting a request) is denied while it's set, everywhere the
    // signed-in user's own uid is checkable without an extra read.
    function isBanned() {
      let profile = /databases/$(database)/documents/donors/$(request.auth.uid);
      // exists() first: get() on a missing profile is a rules error, which
      // would silently deny everyone who hasn't registered a profile yet.
      return isSignedIn() && exists(profile) && get(profile).data.get('is_banned', false) == true;
    }

    // ---------------------------------------------------------------
    // donors/{uid} — private profile: name, phone, exact location.
    // Owner or admin only, ever. is_verified / is_banned are admin-set
    // only — a donor's own update can't touch either field.
    match /donors/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && isVerifiedUser()
        && request.resource.data.is_verified == false
        && request.resource.data.is_banned == false;

      allow update: if isAdmin()
        || (isOwner(uid)
            && resource.data.is_banned == false
            && request.resource.data.is_verified == resource.data.is_verified
            && request.resource.data.is_banned == resource.data.is_banned
            && cooldownRespected());

      // Owner delete = in-app account deletion (App Store 5.1.1(v) /
      // Google Play account-deletion policy). See AccountService.
      // Deliberately unconditional, including for a banned donor: both
      // stores require deletion to always be available in-app, with no
      // carve-out for a suspended account — a ban can't turn into a
      // reason to refuse the request.
      allow delete: if isOwner(uid) || isAdmin();

      // Private attachments (the ID-proof image) — same visibility as the
      // profile itself, kept out of it so profile reads stay small.
      match /private/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // donors_public/{uid} — map-safe mirror. No phone field, ever.
    //
    // NOTE: get()/exists() inside a transaction's rule evaluation sees the
    // database as of BEFORE the transaction started — never a sibling
    // write made earlier in that same transaction. registerDonor() (and
    // every admin/self write below) sets donors/{uid} and donors_public/{uid}
    // together in one transaction, so a rule here that called
    // get(donors/{uid}) would read a doc that doesn't exist yet (brand-new
    // donor) or a stale pre-write value (verify/ban/availability) — always
    // denying. Every check below reads only this document's own fields
    // instead, so it can't depend on write order within the transaction.
    match /donors_public/{uid} {
      allow read: if isSignedIn();

      // A fresh donor always starts unverified (see registerDonor).
      allow create: if ((isOwner(uid) && isVerifiedUser()) || isAdmin())
        && !('phone' in request.resource.data)
        && request.resource.data.is_verified == false;

      // is_verified can only change via an admin write — an owner's own
      // update must leave it exactly as it already was.
      allow update: if (isOwner(uid) || isAdmin())
        && !('phone' in request.resource.data)
        && (isAdmin() || (!isBanned()
              && request.resource.data.is_verified == resource.data.is_verified));

      allow delete: if isOwner(uid) || isAdmin();
    }

    // requests/{id} — the marketplace. Open requests are readable by any
    // signed-in user (that's how donors discover them); once a request
    // stops being open, only the two people involved (or admin) can read
    // it — this is what keeps matched_donor_phone/requester_phone from
    // being visible to a random signed-in user who isn't part of the
    // match. Writes are limited to exactly the transitions
    // backend.dart's client-side transactions perform.
    match /requests/{id} {
      function req() {
        return get(/databases/$(database)/documents/requests/$(id)).data;
      }

      // The two people a matched request connects — the only ones who can
      // ever see its chat or calls.
      function isParticipant() {
        let r = req();
        return isSignedIn()
          && (r.requester_uid == request.auth.uid
              || r.get('matched_donor_id', null) == request.auth.uid);
      }

      // Chat and calls are live only while matched and nobody has blocked.
      function conversationOpen() {
        let r = req();
        return r.status == 'matched' && r.get('chat_closed_by', null) == null;
      }

      function onlyChanges(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function previewUnchangedOrMine() {
        return request.resource.data.get('last_message', null) == resource.data.get('last_message', null)
          || request.resource.data.last_message.sender_uid == request.auth.uid;
      }

      function coreUnchanged() {
        return request.resource.data.requester_uid == resource.data.requester_uid
          && request.resource.data.blood_group == resource.data.blood_group
          && request.resource.data.units_needed == resource.data.units_needed
          && request.resource.data.created_at == resource.data.created_at;
      }

      allow read: if isSignedIn() &&
        (resource.data.status == 'open'
         || resource.data.requester_uid == request.auth.uid
         || resource.data.matched_donor_id == request.auth.uid
         || isAdmin());

      allow create: if isVerifiedUser()
        && !isBanned()
        && request.resource.data.requester_uid == request.auth.uid
        && request.resource.data.status == 'open';

      allow update: if isAdmin() || (isSignedIn() && coreUnchanged() && (
          // requester cancels their own open or matched request
          (resource.data.requester_uid == request.auth.uid
            && resource.data.status in ['open', 'matched']
            && request.resource.data.status == 'cancelled')
          ||
          // a donor accepts an open request
          (resource.data.status == 'open'
            && request.resource.data.status == 'matched'
            && request.resource.data.matched_donor_id == request.auth.uid
            && isVerifiedUser()
            && !isBanned())
          ||
          // two-sided completion: each side stamps only its own
          // confirmation; the request may become `fulfilled` only when the
          // other side has already confirmed (see donorConfirmDonation /
          // requesterConfirmDonation in backend.dart)
          (resource.data.status == 'matched'
            && resource.data.matched_donor_id == request.auth.uid
            && resource.data.get('donor_confirmed_at', null) == null
            && request.resource.data.donor_confirmed_at == request.time
            && onlyChanges(['donor_confirmed_at', 'status', 'fulfilled_at'])
            && (request.resource.data.status == 'matched'
                || (request.resource.data.status == 'fulfilled'
                    && resource.data.get('requester_confirmed_at', null) != null)))
          ||
          (resource.data.status == 'matched'
            && resource.data.requester_uid == request.auth.uid
            && resource.data.get('requester_confirmed_at', null) == null
            && request.resource.data.requester_confirmed_at == request.time
            && onlyChanges(['requester_confirmed_at', 'status', 'fulfilled_at'])
            && (request.resource.data.status == 'matched'
                || (request.resource.data.status == 'fulfilled'
                    && resource.data.get('donor_confirmed_at', null) != null)))
          ||
          // lazy expiry (stands in for the Blaze-only expireOldRequests
          // scheduled function) — any signed-in user, only once genuinely
          // past due, so it can't be used to kill a live request early
          (resource.data.status == 'open'
            && request.resource.data.status == 'expired'
            && request.time > resource.data.expires_at)
          ||
          // the matched donor backs out — request reopens for others with
          // a fresh (bounded) expiry window. See Backend.releaseMatch.
          (resource.data.status == 'matched'
            && resource.data.matched_donor_id == request.auth.uid
            && request.resource.data.status == 'open'
            && request.resource.data.matched_donor_id == null
            && request.resource.data.expires_at <= request.time + duration.value(7, 'h'))
          ||
          // either participant closes (blocks) the conversation, once
          ((resource.data.requester_uid == request.auth.uid
              || resource.data.get('matched_donor_id', null) == request.auth.uid)
            && resource.data.get('chat_closed_by', null) == null
            && request.resource.data.chat_closed_by == request.auth.uid
            && onlyChanges(['chat_closed_by', 'chat_closed_at']))
          ||
          // account deletion scrubs the leaving user's own name/phone
          // (and the inbox preview, which may quote them)
          (resource.data.requester_uid == request.auth.uid
            && onlyChanges(['requester_name', 'requester_phone', 'requester_deleted', 'last_message']))
          ||
          (resource.data.get('matched_donor_id', null) == request.auth.uid
            && onlyChanges(['matched_donor_name', 'matched_donor_phone', 'matched_donor_deleted', 'last_message']))
          ||
          // chat bookkeeping: each side moves only its own read marker, and
          // only the sender may write the inbox preview (always batched
          // with the message itself — see ChatService._send)
          (resource.data.requester_uid == request.auth.uid
            && onlyChanges(['last_message', 'requester_read_at'])
            && previewUnchangedOrMine())
          ||
          (resource.data.get('matched_donor_id', null) == request.auth.uid
            && onlyChanges(['last_message', 'donor_read_at'])
            && previewUnchangedOrMine())
      ));

      // Admin cleanup (spam/duplicate/test requests) — not a transition,
      // so it sits outside coreUnchanged()'s update rule entirely.
      allow delete: if isAdmin();

      // In-app chat. Only the two participants; append-only (a sender may
      // delete their own messages — used by account deletion).
      match /messages/{messageId} {
        allow read: if isParticipant() || isAdmin();
        allow create: if isParticipant() && conversationOpen() && isVerifiedUser()
          && request.resource.data.sender_uid == request.auth.uid
          && request.resource.data.kind in ['text', 'call', 'location']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.kind != 'location'
              || (request.resource.data.lat is number && request.resource.data.lng is number));
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.sender_uid == request.auth.uid;
      }

      // In-app voice calls — Firestore only carries the WebRTC handshake;
      // audio is peer-to-peer and never stored.
      match /calls/{callId} {
        allow read: if isSignedIn()
          && (resource.data.caller_uid == request.auth.uid || resource.data.callee_uid == request.auth.uid);
        allow create: if isParticipant() && conversationOpen() && isVerifiedUser()
          && request.resource.data.caller_uid == request.auth.uid
          && request.resource.data.callee_uid != request.auth.uid
          && (request.resource.data.callee_uid == req().requester_uid
              || request.resource.data.callee_uid == req().get('matched_donor_id', null))
          && request.resource.data.status == 'ringing';
        allow update: if isSignedIn()
          && (resource.data.caller_uid == request.auth.uid || resource.data.callee_uid == request.auth.uid)
          && request.resource.data.caller_uid == resource.data.caller_uid
          && request.resource.data.callee_uid == resource.data.callee_uid;
        allow delete: if false;

        match /{candidateSet}/{candidateId} {
          allow read, create: if isParticipant()
            && candidateSet in ['caller_candidates', 'callee_candidates'];
        }
      }
    }

    // Collection-group read for "is anyone calling me?" (CallService
    // .incomingCalls) — only the call's own two parties.
    match /{path=**}/calls/{callId} {
      allow read: if isSignedIn()
        && (resource.data.callee_uid == request.auth.uid || resource.data.caller_uid == request.auth.uid);
    }

    // reports/{id} — chat/call abuse reports, reviewed by admins only.
    match /reports/{reportId} {
      allow create: if isVerifiedUser()
        && request.resource.data.reporter_uid == request.auth.uid
        && request.resource.data.reason is string;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // donation_history/{id} — immutable once written. Self-reported by
    // the donor (the only real path today) or written by an admin.
    match /donation_history/{id} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.donor_id == request.auth.uid);
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.donor_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // admins/{uid} — existence = admin. Nothing in-app can create the
    // first one (see backend/README.md, manual bootstrap via console); an
    // existing admin can add more. A user may read their OWN doc (so the
    // client can check "am I an admin") without being able to enumerate
    // other admins.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // hospitals/{id} — plain reference data.
    match /hospitals/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // audit_log/{id} — admin actions only, admin-only visibility, never
    // edited or deleted after the fact.
    match /audit_log/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // issue_reports/{id} & partnership_inquiries/{id} — one-way submission
    // forms (Help & support, Partner with us). Any signed-in user can file
    // one under their own uid; only admins can read the inbox. The author
    // can never edit or withdraw a submission — but an admin triages it
    // (status + internal note) from the console's Inbox tab, so admin
    // update/delete is allowed. Everything an admin writes there is
    // mirrored into audit_log by the caller.
    match /issue_reports/{id} {
      allow create: if isVerifiedUser() && request.resource.data.reporter_uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /partnership_inquiries/{id} {
      allow create: if isVerifiedUser() && request.resource.data.requester_uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // community_stories/{id} — "Share an experience". Readable by any
    // signed-in user (that's the point), written only under the author's
    // own uid, and never edited by the author afterwards. Admins moderate:
    // `is_hidden` (reversible — the feed filters it out client-side) or an
    // outright delete.
    // Photo posts: `image_path` must point into the author's own folder in
    // this project's Storage bucket (see storage.rules), never an arbitrary
    // external link. Authors may delete their own post.
    match /community_stories/{id} {
      allow read: if isSignedIn();
      allow create: if isVerifiedUser() && !isBanned()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && (request.resource.data.get('image_path', null) == null
            || request.resource.data.image_path.matches('community/' + request.auth.uid + '/[^/]+'));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.author_uid == request.auth.uid);
    }

    // broadcasts/{id} — admin push to every phone (or one blood group's
    // topic). Writing the doc is the whole API: the onBroadcast function
    // delivers it and stamps status/topic back onto it.
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 300;
      allow update, delete: if false;
    }

    // announcements/{id} — Community → What's New. Admin-authored only;
    // any signed-in user reads them. No user-submitted path at all.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // testimonials/{id} — the curated quotes behind More → Testimonials.
    // Deliberately separate from community_stories: those are member posts,
    // these are copy the team has explicit permission to publish, so only
    // an admin can ever create one.
    match /testimonials/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // testimonial_submissions/{id} — a member offering their own quote, with
    // explicit consent to publish it under their name. Private queue: only
    // admins read it, and approving copies it into `testimonials`.
    match /testimonial_submissions/{id} {
      allow create: if isVerifiedUser() && !isBanned()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.consent_to_publish == true
        && request.resource.data.quote is string
        && request.resource.data.quote.size() >= 10
        && request.resource.data.quote.size() <= 600;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // public_stats/impact — the Community Impact counter. A normal user
    // can't query `requests` for fulfilled ones (those carry phone numbers
    // and stay private), so the aggregate lives here instead. Any signed-in
    // user may bump it, but only by exactly +1, or reset to 1 on a new
    // month — so it can't be inflated in a single write. An admin can set
    // it to any value (correcting a miscount, or seeding the figure for a
    // month whose donations were confirmed offline).
    match /public_stats/{id} {
      allow read: if isSignedIn();

      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.donations_this_month == 1);

      allow update: if isAdmin() || (isSignedIn() && (
          (request.resource.data.month_key == resource.data.month_key
            && request.resource.data.donations_this_month == resource.data.donations_this_month + 1)
          ||
          (request.resource.data.month_key != resource.data.month_key
            && request.resource.data.donations_this_month == 1)
      ));

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
