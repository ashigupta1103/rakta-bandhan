rules_version = '2';

// Rakta Bandhan — Cloud Storage rules.
//
// Only community post photos live in Storage. Each user writes only into
// their own folder, only JPEG/PNG/WebP images, at most 2 MB (the app
// compresses to ~150 KB before upload). Any signed-in user can view them,
// like the posts themselves. Deleting a post deletes its photo
// (functions/src/index.ts → onStoryDeleted); the author can also remove
// their own file directly.
service firebase.storage {
  match /b/{bucket}/o {
    match /community/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.get('email_verified', false) == true
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
