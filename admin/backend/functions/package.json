{
  "name": "rakta-bandhan-admin-functions",
  "description": "Rakta Bandhan — Admin-side Cloud Functions (codebase: admin)",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions,firestore,auth",
