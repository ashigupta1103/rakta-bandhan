<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: allow plain HTTP to the local Firebase emulators
         (dart-define USE_EMULATORS=true). Release builds never get this. -->
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
